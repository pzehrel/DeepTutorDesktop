{
  "name": "deeptutor-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm tauri dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "build": "pnpm tauri build",
    "build:frontend": "pnpm --dir frontend build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --dir frontend typecheck",
    "lint:py": "uv run --project bridge ruff check",
    "format:check:py": "uv run --project bridge ruff format --check",
    "typecheck:py": "uv run --project bridge pyright",
    "test:bridge": "uv run --project bridge pytest",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:py && pnpm format:check:py && pnpm typecheck:py && pnpm test:bridge",
    "postbuild": "node scripts/rename-bundles.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "eslint": "^9.0.0"
  }
}
